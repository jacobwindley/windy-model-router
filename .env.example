# URL of your LiteLLM or bifrost instance
LITELLM_URL=http://localhost:4000

# API key to authenticate requests TO this router (leave empty to disable auth)
ROUTER_API_KEY=

# API key to pass through to LiteLLM (if LiteLLM requires one)
LITELLM_API_KEY=

# Session state config
SESSION_TTL_SECONDS=3600
SESSION_MAX_SIZE=10000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path to the Tier-1 routing rules file
RULES_PATH=config/rules.yaml
